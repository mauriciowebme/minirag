{
  "name": "minirag",
  "version": "2.0.0",
  "description": "Serviço RAG multi-tenant: Node/TypeScript + Postgres(pgvector) + embedder Python (nomic-embed-text-v1.5)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "build:tests": "tsc -p tsconfig.tests.json",
    "test": "npm run build:tests && node --test --test-reporter=spec --test-concurrency=1 tests-dist/e2e.test.js",
    "build:frontend": "cd frontend && npm run build"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/yazl": "^2.4.6",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
